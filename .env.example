# Telegram bot token from BotFather. Keep the real value in your hosting provider's Secrets/Environment settings.
BOT_TOKEN=

# Optional: set this to the mount path of a Render Persistent Disk, for example:
# WHATSAPP_AUTH_DIR=/var/data/manixmdtimewisher/pairing
WHATSAPP_AUTH_DIR=

# Credentialed sessions are never auto-deleted. This only cleans old unpaired folders.
WHATSAPP_SESSION_TTL_DAYS=30

# Optional: Groq API key for AI commands. Store the real value as a private Render secret.
GROQ_API_KEY=

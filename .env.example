# Telegram bot token from BotFather. Keep the real value in your hosting provider's Secrets/Environment settings.
BOT_TOKEN=

# Optional: set this to the mount path of a Render Persistent Disk, for example:
# WHATSAPP_AUTH_DIR=/var/data/manixmdtimewisher/pairing
WHATSAPP_AUTH_DIR=

# Credentialed sessions are never auto-deleted. This only cleans old unpaired folders.
WHATSAPP_SESSION_TTL_DAYS=30

# Optional: override the WhatsApp handshake values if WhatsApp changes its registration endpoint.
BAILEYS_VERSION=2,3000,1034074495
BAILEYS_BROWSER=MANI XMD,Chrome,145.0.0

# Optional: Groq API key for AI commands. Store the real value as a private Render secret.
GROQ_API_KEY=

# Optional: public QR dashboard URL used by the .pair command.
QR_DASHBOARD_URL=https://manix-md.onrender.com/

# Optional provider keys for commands that use these services.
RAPIDAPI_KEY=
NEWSAPI_KEY=
OMDB_API_KEY=
OPENROUTER_API_KEY=
NEXORACLE_API_KEY=
FREEFIRE_API_KEY=
REMOVEBG_API_KEY=
# Keep dangerous owner consoles disabled in production unless explicitly required.
ENABLE_OWNER_EVAL=false
ENABLE_OWNER_SHELL=false

# Optional media/search provider settings.
YTDLP_PATH=
# Refresh the bundled yt-dlp executable during npm install; defaults to true.
YT_DLP_AUTO_UPDATE=true
# Optional Netscape-format cookies file for YouTube or TikTok server-side challenges.
YT_COOKIES_PATH=
# Optional realistic browser user-agent for TikTok embed fallback.
TIKTOK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
# Optional Netscape-format cookies file for Instagram login/private-post challenges.
INSTAGRAM_COOKIES_PATH=
# Optional authorized Cobalt endpoint. Do not use an instance without permission.
# For YouTube audio, this must be the authorized instance's POST / endpoint.
COBALT_API_URL=
COBALT_API_KEY=
# Optional current no-cookie YouTube MP3 conversion host; defaults to https://p.savenow.to
SAVENOW_API_URL=https://p.savenow.to
# Optional no-cookie OminiSave YouTube MP3 endpoint used by .song/.play fallback.
OMINISAVE_API_URL=https://www.ominisave.com
# Optional comma-separated Piped API instances for bot-check fallback.
# If omitted, the bot refreshes the current public list from TeamPiped documentation.
PIPED_API_URLS=
